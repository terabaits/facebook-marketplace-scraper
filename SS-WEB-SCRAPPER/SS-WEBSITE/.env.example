# Flask environment variables for SS-Crawler Dashboard
# -------------------------------------------------
# Copy this file to .env and fill in the values below.
# Do not commit the .env file to version control (it contains secrets).

# Required in production; must be set when DEBUG is not True
FLASK_SECRET_KEY=<generate-with-secrets-token-hex-32>

# Database connection
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=ss_market
DATABASE_USER=crawler
DATABASE_PASSWORD=crawler_pass

# Optional: Flask configuration
# FLASK_ENV=development    # or production
# DEBUG=True             # set for local development (enables secret key fallback)

# Server
HOST=0.0.0.0
PORT=5000