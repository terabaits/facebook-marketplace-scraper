    .laptop-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .laptop-hero-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.01em;
        color: var(--text-color);
    }
    .laptop-hero-title svg {
        width: 32px;
        height: 32px;
        padding: 6px;
        border-radius: 9px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        box-shadow: 0 2px 8px rgba(102,126,234,0.45);
