    /* SVG-icon toggle bar (matches gpu.html .filter-icon-btn) */
    .laptop-icon-bar {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .laptop-icon-btn {
        position: relative;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        border: 1px solid var(--table-border);
        background: var(--input-bg, transparent);
        color: var(--text-secondary);
        cursor: pointer;
        transition: background 0.15s, color 0.15s, border-color 0.15s, transform 0.1s;
        padding: 0;
    }
    .laptop-icon-btn:hover {
        border-color: var(--primary, #667eea);
        color: var(--text-color);
        transform: translateY(-1px);
    }
    .laptop-icon-btn:focus-visible {
        outline: 2px solid var(--link-color);
        outline-offset: 2px;
