    async function loadLaptops(page = 0) {
        const append = page > 0;
        currentPage = page;
        const params = new URLSearchParams();
        params.append('active', isToggleOn('active-only'));
        params.append('exclude_flagged', isToggleOn('exclude-flagged'));
        params.append('include_perekups', isToggleOn('include-perekups'));
        params.append('include_lombards', isToggleOn('include-lombards'));
        params.append('sort', document.getElementById('sort-by').value);
        params.append('order', document.getElementById('sort-order').value);
        params.append('time', document.getElementById('time-filter').value);
        params.append('limit', pageSize);
        params.append('offset', page * pageSize);

        const brand = document.getElementById('brand-filter').value;
        if (brand) params.append('brand', brand);
        const selectedCpus = Array.from(document.querySelectorAll('#cpu-options input[type=checkbox]:checked')).map(cb => cb.value);
        selectedCpus.forEach(cpu => params.append('cpu', cpu));
        const gpu = document.getElementById('gpu-filter').value;
        if (gpu) params.append('gpu', gpu);
        const minPrice = document.getElementById('min-price').value;
        if (minPrice) params.append('min_price', minPrice);
        const maxPrice = document.getElementById('max-price').value;
        if (maxPrice) params.append('max_price', maxPrice);
        const ramMin = document.getElementById('ram-min').value;
        if (ramMin) params.append('ram_min', ramMin);
        const ramMax = document.getElementById('ram-max').value;
        if (ramMax) params.append('ram_max', ramMax);
        const storageMin = document.getElementById('storage-min').value;
        if (storageMin) params.append('storage_min', storageMin);
        const storageMax = document.getElementById('storage-max').value;
        if (storageMax) params.append('storage_max', storageMax);
        const storageType = document.getElementById('storage-type').value;
        if (storageType) params.append('storage_type', storageType);
        const displaySizeMin = document.getElementById('display-size-min').value;
        if (displaySizeMin) params.append('display_size_min', displaySizeMin);
        const displaySizeMax = document.getElementById('display-size-max').value;
        if (displaySizeMax) params.append('display_size_max', displaySizeMax);
        const displaySize = document.getElementById('display-size').value;
        if (displaySize) params.append('display_size', displaySize);
        const macbookOnly = isToggleOn('macbook-only');
        if (macbookOnly) params.append('macbook_only', 'true');
        else params.append('exclude_macbooks', 'true');
        const modelFilter = document.getElementById('model-filter').value;
        if (modelFilter) params.append('model', modelFilter);

        saveFilters();

        const container = document.getElementById('listings-container');
        const sentinel = document.getElementById('laptop-sentinel');
        if (isLoading) return;
        isLoading = true;
        if (sentinel) sentinel.style.display = 'flex';

        try {
            if (!append) {
                container.innerHTML = '<div class="loading">Loading laptop listings...</div>';
                currentListings = [];
                hasMore = true;
            }

            const response = await fetch('/api/laptops?' + params.toString());
            const data = await response.json();

            if (data.error) {
                throw new Error(data.error);
            }

            const listings = data.listings || [];
            totalListings = data.total || 0;

            if (!append) {
                currentListings = listings;
                populateBrandFilter(listings);
            } else {
                currentListings = currentListings.concat(listings);
                populateBrandFilter(currentListings);
            }

            updatePagination();

            if (!append && listings.length === 0) {
                container.innerHTML = '<div class="loading">No laptop listings found</div>';
                hasMore = false;
                return;
            }

            let grid = document.getElementById('laptop-grid');
            if (!grid) {
                container.innerHTML = '<div class="laptop-grid" id="laptop-grid"></div>';
                grid = document.getElementById('laptop-grid');
            }

            grid.insertAdjacentHTML('beforeend', listings.map(renderLaptopCard).join(''));
            hasMore = listings.length === pageSize && currentListings.length < totalListings;
        } catch (error) {
            if (!append) {
                container.innerHTML = `<div class="error">Failed to load listings: ${error.message}</div>`;
            } else {
                console.error('Failed to load more listings', error);
            }
            hasMore = false;
        } finally {
            isLoading = false;
            if (sentinel) sentinel.style.display = hasMore ? 'flex' : 'none';
        }
    }

