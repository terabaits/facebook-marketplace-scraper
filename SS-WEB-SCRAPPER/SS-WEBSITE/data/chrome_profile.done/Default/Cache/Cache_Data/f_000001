    function classifyCpuVendor(cpu) {
        const n = cpu.toLowerCase();
        if (n.includes('apple') || /\bm\d+\b/.test(n)) return 'Mac';
        if (n.includes('snapdragon') || n.includes('qualcomm')) return 'Snapdragon';
        if (n.includes('intel') || n.includes('core') || n.includes('pentium') || n.includes('celeron') || n.includes('atom') || /\bi[3579]\b/.test(n) || n.includes('core ultra')) return 'Intel';
        if (n.includes('amd') || n.includes('ryzen') || n.includes('athlon')) return 'AMD';
        return 'Other';
    }

    function classifyCpuClass(cpu, vendor) {
        const n = cpu.toLowerCase();
        if (vendor === 'Mac') {
            const m = n.match(/\bm(\d+)(?:\s+(pro|max|ultra))?\b/);
            if (m) return 'M' + m[1];
            return 'Other';
        }
        if (vendor === 'Snapdragon') {
            if (n.includes('x elite')) return 'X Elite';
            const gen = n.match(/gen\s*(\d+)/);
            if (gen) return 'Gen ' + gen[1];
            return 'Other';
        }
        if (vendor === 'AMD') {
            const r = n.match(/ryzen\s*(\d+)/);
            if (r) return 'Ryzen ' + r[1];
            if (n.includes('athlon')) return 'Athlon';
            return 'Other';
        }
        if (vendor === 'Intel') {
            const i = n.match(/\bi([3579])\b/);
            if (i) return 'i' + i[1];
            if (n.includes('core ultra')) return 'Core Ultra';
            if (n.includes('pentium')) return 'Pentium';
            if (n.includes('celeron')) return 'Celeron';
            if (n.includes('atom')) return 'Atom';
            return 'Other';
        }
        return 'Other';
    }

    function cpuGenerationScore(cpu) {
        const n = cpu.toLowerCase();
        // Apple M series
        const m = n.match(/\bm(\d+)(?:\s+(pro|max|ultra))?\b/);
        if (m) {
            let score = parseInt(m[1], 10) * 1000;
            const suffix = m[2];
            if (suffix === 'pro') score += 200;
            else if (suffix === 'max') score += 300;
            else if (suffix === 'ultra') score += 400;
            return score;
        }
        // Snapdragon Gen
        const gen = n.match(/gen\s*(\d+)/);
        if (gen) return parseInt(gen[1], 10) * 1000;
        if (n.includes('x elite')) return 5000;
        // Largest numeric cluster as a proxy for generation/model
        const nums = n.match(/\d{3,5}/g);
        if (nums) return Math.max(...nums.map(Number));
        return 0;
    }

    function classifyCpuGeneration(cpu, vendor) {
        const n = cpu.toLowerCase();
        if (vendor === 'Mac') {
            const m = n.match(/\bm(\d+)(?:\s+(pro|max|ultra))?\b/);
            return m ? 'M' + m[1] : 'Other';
        }
        if (vendor === 'Snapdragon') {
            const gen = n.match(/gen\s*(\d+)/);
            return gen ? 'Gen ' + gen[1] : 'Other';
        }
        if (vendor === 'AMD') {
            // Ryzen 7 5800U -> 5000 series; Ryzen 7 7840HS -> 7000 series
            const nums = n.match(/\b(\d{4})\b/);
            if (nums) {
                const series = Math.floor(parseInt(nums[1], 10) / 1000) * 1000;
                return series ? series + ' Series' : 'Other';
            }
            return 'Other';
        }
        if (vendor === 'Intel') {
            const nLower = cpu.toLowerCase();
            // Core i5-1235U / Core i7-1165G7 / Core i5-8350 / i5 6200U / I5-8265U
            const match = nLower.match(/(?:core\s+)?i\s*([3579])\s*[-\s]?(\d{3,5})/);
            if (match) {
                const model = match[2];
                if (/^\d{5}$/.test(model)) return model.slice(0, 2) + 'th Gen';
                if (/^\d{4}$/.test(model)) return model.slice(0, 1) + 'th Gen';
            }
            if (nLower.includes('core ultra')) return 'Core Ultra';
            if (nLower.includes('pentium')) return 'Pentium';
            if (nLower.includes('celeron')) return 'Celeron';
            if (nLower.includes('atom')) return 'Atom';
            return 'Other';
        }
        return 'Other';
    }

    function renderCPUOptions() {
        const wrapper = document.getElementById('cpu-options-list');
        const sortMode = document.getElementById('cpu-sort-mode').value;
        const groupMode = document.getElementById('cpu-group-mode').value;
        const selected = new Set();
        const pendingRaw = document.getElementById('cpu-options').dataset.pending;
        if (pendingRaw) {
            try {
                JSON.parse(pendingRaw).forEach(v => selected.add(v));
                delete document.getElementById('cpu-options').dataset.pending;
            } catch (e) {}
        }
        document.querySelectorAll('#cpu-options input:checked').forEach(cb => selected.add(cb.value));

        const vendorOrder = ['Intel', 'AMD', 'Snapdragon', 'Mac', 'Other'];
        const classOrder = {
            'Intel': ['i9', 'i7', 'i5', 'i3', 'Core Ultra', 'Pentium', 'Celeron', 'Atom', 'Other'],
            'AMD': ['Ryzen 9', 'Ryzen 7', 'Ryzen 5', 'Ryzen 3', 'Athlon', 'Other'],
            'Snapdragon': ['X Elite', 'Gen 5', 'Gen 4', 'Gen 3', 'Gen 2', 'Gen 1', 'Other'],
            'Mac': ['M4', 'M3', 'M2', 'M1', 'Other']
        };
        // Vendor accent colors
        const vendorColor = {
            'Intel': '#0071c5',
            'AMD': '#ed1c24',
            'Mac': '#6e6e73',
            'Snapdragon': '#3253dc',
        };
        // Tier names per class (best-effort)
        const tierByClass = {
            'i9': 'Enthusiast', 'Core Ultra': 'High-End',
            'i7': 'High-End', 'i5': 'Mid-Range', 'i3': 'Budget',
            'Pentium': 'Budget', 'Celeron': 'Budget', 'Atom': 'Budget', 'Xeon': 'Enthusiast',
            'Ryzen 9': 'Enthusiast', 'Ryzen 7': 'High-End', 'Ryzen 5': 'Mid-Range', 'Ryzen 3': 'Budget',
            'M4': 'Apple Silicon', 'M3': 'Apple Silicon', 'M2': 'Apple Silicon', 'M1': 'Apple Silicon',
            'X Elite': 'ARM', 'Gen 5': 'ARM', 'Gen 4': 'ARM', 'Gen 3': 'ARM', 'Gen 2': 'ARM', 'Gen 1': 'ARM',
        };

        const options = [...allCpuOptions];
        if (sortMode === 'count-desc') options.sort((a, b) => b[1] - a[1]);
        else if (sortMode === 'count-asc') options.sort((a, b) => a[1] - b[1]);
        else if (sortMode === 'newest') options.sort((a, b) => cpuGenerationScore(b[0]) - cpuGenerationScore(a[0]));
        else options.sort((a, b) => a[0].toLowerCase().localeCompare(b[0].toLowerCase()));

        const grouped = {};
        options.forEach(([cpu, count]) => {
            const vendor = classifyCpuVendor(cpu);
            const cls = groupMode === 'generation' ? classifyCpuGeneration(cpu, vendor) : classifyCpuClass(cpu, vendor);
            if (!grouped[vendor]) grouped[vendor] = {};
            if (!grouped[vendor][cls]) grouped[vendor][cls] = [];
            grouped[vendor][cls].push({cpu, count});
        });

        let html = '';
        vendorOrder.forEach(vendor => {
            const classes = grouped[vendor];
            if (!classes) return;
            let classKeys = Object.keys(classes);
            if (groupMode === 'generation') {
                classKeys = classKeys.sort((a, b) => {
                    const toNum = s => {
                        const m = s.match(/\d+/);
                        return m ? parseInt(m[0], 10) : 0;
                    };
                    return toNum(b) - toNum(a);
                });
            } else {
                const order = classOrder[vendor] || [];
                classKeys = classKeys.sort((a, b) => {
                    const ia = order.indexOf(a);
                    const ib = order.indexOf(b);
                    if (ia !== -1 && ib !== -1) return ia - ib;
                    if (ia !== -1) return -1;
                    if (ib !== -1) return 1;
                    return a.localeCompare(b);
                });
            }
            // Aggregate vendor stats
            let vendorCpuCount = 0;
            let vendorListingCount = 0;
            classKeys.forEach(cls => {
                vendorCpuCount += classes[cls].length;
                classes[cls].forEach(({count}) => { vendorListingCount += count; });
            });
            const dotColor = vendorColor[vendor] || '#888';

            html += `<div class="cpu-vendor-section" data-vendor="${vendor}">
                <div class="cpu-vendor-header">
                    <span class="cpu-vendor-dot" style="background: ${dotColor};"></span>
                    <span class="cpu-vendor-name">${vendor}</span>
                    <span class="cpu-vendor-meta">${classKeys.length} ${classKeys.length === 1 ? 'class' : 'classes'} · ${vendorCpuCount} CPUs · ${vendorListingCount} listings</span>
                </div>`;
            classKeys.forEach(cls => {
                const items = classes[cls];
                const allChecked = items.length > 0 && items.every(({cpu}) => selected.has(cpu));
                const someChecked = items.some(({cpu}) => selected.has(cpu));
                const tier = tierByClass[cls] || '';
                html += `<div class="cpu-class-block ${someChecked || allChecked ? 'expanded' : ''}" data-class="${cls}">
                    <div class="cpu-class-header" onclick="toggleCpuClass(this)">
                        <div class="cpu-class-left">
                            <svg class="cpu-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="9 6 15 12 9 18"/>
                            </svg>
                            <span class="cpu-class-label">${cls}</span>
                            ${tier ? `<span class="cpu-class-tier">${tier}</span>` : ''}
                        </div>
                        <div class="cpu-class-actions" onclick="event.stopPropagation()">
                            <span class="cpu-class-count">${items.length} ${items.length === 1 ? 'CPU' : 'CPUs'}</span>
                            <label class="cpu-class-toggle" title="Select all in ${cls}">
                                <input type="checkbox" onclick="event.stopPropagation()" onchange="markCpuClass(this, this.checked)">
                                <span>Select all</span>
                            </label>
                        </div>
                    </div>
                    <div class="cpu-options-grid">`;
                items.forEach(({cpu, count}) => {
                    const val = cpu.replace(/"/g, '&quot;');
                    const checked = selected.has(cpu);
                    html += `
                        <label class="cpu-option ${checked ? 'checked' : ''}" data-cpu="${val}" title="${val}">
                            <input type="checkbox" value="${val}" ${checked ? 'checked' : ''}>
                            <svg class="cpu-option-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                            <span class="cpu-option-name">${cpu}</span>
                            <span class="cpu-option-count">${count}</span>
                        </label>`;
                });
                html += `</div></div>`;
            });
            html += `</div>`;
        });

        wrapper.innerHTML = html || '<div style="padding: 0.25rem; color: #888;">No CPU data</div>';
        // Wire up the option change handler
        wrapper.querySelectorAll('.cpu-option input[type=checkbox]').forEach(cb => {
            cb.addEventListener('change', (e) => {
                const label = e.target.closest('.cpu-option');
                if (label) label.classList.toggle('checked', e.target.checked);
                updateCPUFilterLabel();
                updatePopupFooter();
            });
        });
        // Re-apply the current search filter
        filterCPUOptionsBySearch();
        updateCPUFilterLabel();
        updatePopupFooter();
    }

    function filterCPUOptionsBySearch() {
        const q = (document.getElementById('cpu-popup-search-input')?.value || '').trim().toLowerCase();
        const wrapper = document.getElementById('cpu-options-list');
        if (!wrapper) return;
        wrapper.querySelectorAll('.cpu-option').forEach(opt => {
            const cpu = (opt.dataset.cpu || '').toLowerCase();
            const show = !q || cpu.includes(q);
            opt.classList.toggle('hidden', !show);
        });
        wrapper.querySelectorAll('.cpu-class-block').forEach(block => {
            const visibleOpts = block.querySelectorAll('.cpu-option:not(.hidden)').length;
            block.classList.toggle('hidden', q && visibleOpts === 0);
        });
        wrapper.querySelectorAll('.cpu-vendor-section').forEach(section => {
            const visibleOpts = section.querySelectorAll('.cpu-option:not(.hidden)').length;
            section.classList.toggle('hidden', q && visibleOpts === 0);
        });
    }

    function updatePopupFooter() {
        const checked = Array.from(document.querySelectorAll('#cpu-options input:checked'));
        const countEl = document.getElementById('cpu-popup-count');
        const infoEl = document.getElementById('cpu-popup-footer-info');
        const applyBtn = document.querySelector('.cpu-popup-btn-primary');
        if (countEl) countEl.textContent = `${checked.length} selected`;
        let total = 0;
        checked.forEach(cb => {
            const opt = cb.closest('.cpu-option');
            const c = opt && opt.querySelector('.cpu-option-count');
            if (c) total += parseInt(c.textContent, 10) || 0;
        });
        if (infoEl) infoEl.textContent = `${checked.length} selected · ${total} listings`;
        if (applyBtn) applyBtn.textContent = checked.length ? `Apply (${checked.length})` : 'Apply';
    }

    function closeCPUFilter() {
        const el = document.getElementById('cpu-options');
        if (el) el.classList.remove('open');
    }

    function applyCPUFilter() {
        loadLaptops();
        updateCPUFilterLabel();
        renderActiveFilters();
        closeCPUFilter();
    }

    function toggleCPUFilter() {
        const el = document.getElementById('cpu-options');
        const wasOpen = el.classList.contains('open');
        el.classList.toggle('open');
        if (!wasOpen) {
            setTimeout(() => {
                const search = document.getElementById('cpu-popup-search-input');
                if (search) search.focus();
            }, 50);
            document.querySelectorAll('.cpu-class-block').forEach(block => {
                const hasChecked = block.querySelectorAll('.cpu-option.checked').length > 0;
                if (hasChecked) block.classList.add('expanded');
            });
        }
    }

    function updateCPUFilterLabel() {
        const selected = Array.from(document.querySelectorAll('#cpu-options input:checked')).map(cb => cb.value);
        document.getElementById('cpu-selected-label').textContent = selected.length ? `${selected.length} selected` : 'Any';
    }

    function toggleCpuClass(header) {
        const block = header.closest('.cpu-class-block');
        if (block) block.classList.toggle('expanded');
    }

    function markCpuClass(checkbox, select) {
        const block = checkbox.closest('.cpu-class-block');
        if (!block) return;
        const grid = block.querySelector('.cpu-options-grid');
        grid.querySelectorAll('input[type=checkbox]').forEach(cb => {
            cb.checked = select;
            const lbl = cb.closest('.cpu-option');
            if (lbl) lbl.classList.toggle('checked', select);
        });
        if (select) block.classList.add('expanded');
        loadLaptops();
        updateCPUFilterLabel();
        updatePopupFooter();
    }

    function clearAllCpus() {
        document.querySelectorAll('#cpu-options input[type=checkbox]').forEach(cb => {
            cb.checked = false;
            const lbl = cb.closest('.cpu-option');
            if (lbl) lbl.classList.remove('checked');
        });
        document.querySelectorAll('.cpu-class-block').forEach(b => b.classList.remove('expanded'));
        updatePopupFooter();
    }

    document.addEventListener('click', (e) => {
        const group = document.getElementById('cpu-filter-group');
        if (group && !group.contains(e.target)) {
            document.getElementById('cpu-options').classList.remove('open');
        }
    });

    function updatePagination() {
        const pageInfo = document.getElementById('page-info');
        if (pageInfo) {
            pageInfo.textContent = `${currentListings.length} of ${totalListings} laptops`;
        }
    }

    function populateBrandFilter(listings) {
        const select = document.getElementById('brand-filter');
        const current = select.value;
        const brands = new Set(listings.map(l => l.brand).filter(Boolean));
        const existing = Array.from(select.options).map(o => o.value);
        brands.forEach(brand => {
            if (!existing.includes(brand)) {
                const option = document.createElement('option');
                option.value = brand;
                option.textContent = brand;
                select.appendChild(option);
            }
        });
        if (current && Array.from(select.options).some(o => o.value === current)) {
            select.value = current;
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        restoreFilters();
        syncToggleButtons();
        loadLaptopStats();
        loadCPUOptions().then(() => {
            updateCPUFilterLabel();
            renderActiveFilters();
            loadLaptops(0);

            // Wire up the CPU popup search input
            const searchInput = document.getElementById('cpu-popup-search-input');
            if (searchInput) {
                searchInput.addEventListener('input', filterCPUOptionsBySearch);
                searchInput.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape') {
                        e.preventDefault();
                        closeCPUFilter();
                    } else if (e.key === 'Enter') {
                        e.preventDefault();
                        applyCPUFilter();
                    }
                });
            }
            // Close the popup when clicking outside it
            document.addEventListener('click', (e) => {
                const dropdown = document.getElementById('cpu-options');
                const trigger = document.getElementById('cpu-filter-group');
                if (!dropdown || !trigger) return;
                if (dropdown.classList.contains('open')
                    && !dropdown.contains(e.target)
                    && !trigger.contains(e.target)) {
                    closeCPUFilter();
                }
            });
            // Debug helper: ?open_cpu=1 auto-opens the popup (used for screenshots)
            if (new URLSearchParams(location.search).get('open_cpu') === '1') {
                setTimeout(() => {
                    toggleCPUFilter();
                    // Pre-select a couple of CPUs so the screenshot shows checked state
                    setTimeout(() => {
                        const opts = document.querySelectorAll('.cpu-option .cpu-option-name');
                        for (const el of opts) {
                            if (['i7-1165G7', 'i7-1265U', 'Apple M2'].includes(el.textContent)) {
                                const cb = el.closest('.cpu-option').querySelector('input');
                                if (cb && !cb.checked) cb.click();
                            }
                        }
                        // Auto-expand i7 and M2 class blocks
                        document.querySelectorAll('.cpu-class-block').forEach(b => {
                            const lbl = b.querySelector('.cpu-class-label')?.textContent;
                            if (['i7', 'M2'].includes(lbl)) b.classList.add('expanded');
                        });
                        updatePopupFooter();
                    }, 300);
                }, 1500);
            }
            // Esc anywhere closes the popup
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') {
                    const dropdown = document.getElementById('cpu-options');
                    if (dropdown && dropdown.classList.contains('open')) {
                        closeCPUFilter();
                    }
                }
                // "/" focuses the search when popup is open and target is not an input
                if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(e.target.tagName)) {
                    const dropdown = document.getElementById('cpu-options');
                    if (dropdown && dropdown.classList.contains('open')) {
                        e.preventDefault();
                        const si = document.getElementById('cpu-popup-search-input');
                        if (si) si.focus();
                    }
                }
            });

            const sentinel = document.getElementById('laptop-sentinel');
            if (sentinel && 'IntersectionObserver' in window) {
                const observer = new IntersectionObserver(entries => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting && !isLoading && hasMore) {
                            loadLaptops(currentPage + 1);
                        }
                    });
                }, { rootMargin: '200px' });
                observer.observe(sentinel);
            }
        });
    });

    function clearFilters() {
        document.getElementById('brand-filter').value = '';
        setToggle('macbook-only', false);
        document.getElementById('gpu-filter').value = '';
        document.getElementById('min-price').value = '';
        document.getElementById('max-price').value = '';
        document.getElementById('ram-min').value = '';
        document.getElementById('ram-max').value = '';
        document.getElementById('storage-min').value = '';
        document.getElementById('storage-max').value = '';
        document.getElementById('storage-type').value = '';
        document.getElementById('display-size-min').value = '';
        document.getElementById('display-size-max').value = '';
        document.getElementById('display-size').value = '';
        document.getElementById('model-filter').value = '';
        document.getElementById('sort-by').value = 'date_posted';
        document.getElementById('sort-order').value = 'desc';
        document.getElementById('time-filter').value = 'all_time';
        setToggle('active-only', true);
        setToggle('exclude-flagged', true);
        setToggle('include-perekups', true);
        setToggle('include-lombards', true);
        document.querySelectorAll('#cpu-options input:checked').forEach(cb => cb.checked = false);
        syncToggleButtons();
        currentPage = 0;
        saveFilters();
        loadLaptops(0);
    }

    function renderActiveFilters() {
        const container = document.getElementById('active-filters');
        const chips = [];
        const brand = document.getElementById('brand-filter').value;
        if (brand) chips.push(['Brand', brand]);
        document.querySelectorAll('#cpu-options input:checked').forEach(cb => chips.push(['CPU', cb.value]));
        const gpu = document.getElementById('gpu-filter').value;
        if (gpu) chips.push(['GPU', gpu]);
        const minPrice = document.getElementById('min-price').value;
        const maxPrice = document.getElementById('max-price').value;
        if (minPrice || maxPrice) chips.push(['Price', `${minPrice || '0'}€ – ${maxPrice || '∞'}`]);
        const ramMin = document.getElementById('ram-min').value;
        const ramMax = document.getElementById('ram-max').value;
        if (ramMin || ramMax) chips.push(['RAM', `${ramMin || '0'} – ${ramMax || '∞'} GB`]);
        const storageMin = document.getElementById('storage-min').value;
        const storageMax = document.getElementById('storage-max').value;
        if (storageMin || storageMax) chips.push(['Storage', `${storageMin || '0'} – ${storageMax || '∞'} GB`]);
        const storageType = document.getElementById('storage-type').value;
        if (storageType) chips.push(['Storage type', storageType]);
        const displaySizeMin = document.getElementById('display-size-min').value;
        const displaySizeMax = document.getElementById('display-size-max').value;
        if (displaySizeMin || displaySizeMax) chips.push(['Screen', `${displaySizeMin || '0'}″ – ${displaySizeMax || '∞'}″`]);
        const displaySize = document.getElementById('display-size').value;
        if (displaySize) chips.push(['Display', `${displaySize}″`]);
        const modelFilter = document.getElementById('model-filter').value;
        if (modelFilter) chips.push(['Model', modelFilter]);
        if (isToggleOn('macbook-only')) chips.push(['Include macbooks', null, 'macbook-only']);
        const time = document.getElementById('time-filter').value;
        if (time !== 'all_time') chips.push(['Time', time.replace('d', ' days')]);
        if (!isToggleOn('active-only')) chips.push(['Active', 'off', 'active-only']);
        if (!isToggleOn('exclude-flagged')) chips.push(['Flagged', 'included', 'exclude-flagged']);
        if (!isToggleOn('include-perekups')) chips.push(['Perekups', 'hidden', 'include-perekups']);
        if (!isToggleOn('include-lombards')) chips.push(['Lombards', 'hidden', 'include-lombards']);

        if (chips.length === 0) {
            container.innerHTML = '';
            return;
        }
        container.innerHTML =
            '<span class="laf-label">Active filters:</span>' +
            chips.map(([label, value, clearId]) => {
                const text = value === null || value === undefined ? label : `${label}: ${value}`;
                if (clearId) {
                    // Click the chip to clear that toggle (mirror the icon button).
                    return `<span class="laf-chip" title="Click to clear">${text}<button type="button" aria-label="Clear" onclick="event.stopPropagation(); setToggle('${clearId}', ${clearId === 'macbook-only' ? 'false' : 'true'}); syncToggleButtons(); loadLaptops();">&times;</button></span>`;
                }
                return `<span class="laf-chip">${text}</span>`;
            }).join('');
    }

    function cleanLaptopTitle(title) {
        return title.replace(/^SS\.COM Datori un orgtehnika - Piezīmjdatori, Cena\s*[\d\s]+\s*€\.\s*/i, '').trim();
    }

    function openLaptopLightbox(url, alt) {
        let overlay = document.getElementById('laptop-lightbox');
        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'laptop-lightbox';
            overlay.className = 'lightbox-overlay';
            overlay.innerHTML = '<img loading="lazy">';
            document.body.appendChild(overlay);
            overlay.addEventListener('click', () => overlay.classList.remove('active'));
            // Capture phase so this runs before base.html's modal Escape handler;
            // stopPropagation keeps Escape from closing the underlying detail modal too.
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && overlay.classList.contains('active')) {
                    overlay.classList.remove('active');
                    e.stopPropagation();
                }
            }, true);
        }
        const img = overlay.querySelector('img');
        img.src = url;
        img.alt = alt || '';
        overlay.classList.add('active');
    }

    function openSimilarModal(listingId) {
        const item = currentListings.find(l => l.listing_id === listingId);
        if (!item) return;
        similarTarget = item;
        const container = document.getElementById('similar-options');
        const specs = [
            { key: 'brand', label: 'Brand', value: item.brand || '' },
            { key: 'model', label: 'Model', value: item.model || '' },
            { key: 'cpu_raw', label: 'CPU', value: item.cpu_raw || '' },
            { key: 'gpu_raw', label: 'GPU', value: item.gpu_raw || '' },
            { key: 'ram_gb', label: 'RAM', value: item.ram_gb ? `${item.ram_gb} GB` : '' },
            { key: 'storage_gb', label: 'Storage size', value: item.storage_gb ? `${item.storage_gb} GB` : '' },
            { key: 'storage_type', label: 'Storage type', value: item.storage_type || '' },
            { key: 'display_size', label: 'Display', value: item.display_size ? `${item.display_size}"` : '' }
        ].filter(s => s.value);

        container.innerHTML = specs.map((s, i) => `
            <label style="display:flex; align-items:center; gap:0.5rem; cursor:pointer;">
                <input type="checkbox" id="similar-${s.key}" value="${s.key}" checked>
                <span><strong>${s.label}</strong>: ${s.value}</span>
            </label>
        `).join('') || '<p>No usable specs for this listing.</p>';
        document.getElementById('similar-modal').style.display = 'flex';
    }

    function closeSimilarModal() {
        document.getElementById('similar-modal').style.display = 'none';
        similarTarget = null;
    }

    function applySimilarFilter() {
        if (!similarTarget) return;
        const item = similarTarget;
        const checked = new Set(Array.from(document.querySelectorAll('#similar-options input:checked')).map(cb => cb.value));

        const parseNum = (v) => {
            if (!v) return '';
            const n = parseFloat(String(v).replace(/[^0-9.]/g, ''));
            return isNaN(n) ? '' : String(n);
        };

        // Reset everything first
        document.getElementById('brand-filter').value = checked.has('brand') ? (item.brand || '') : '';
        setToggle('macbook-only', checked.has('brand') && (item.brand || '').toLowerCase() === 'apple');
        document.getElementById('model-filter').value = checked.has('model') ? (item.model || '') : '';
        document.getElementById('gpu-filter').value = checked.has('gpu_raw') ? (item.gpu_raw || '') : '';
        document.getElementById('ram-min').value = checked.has('ram_gb') ? parseNum(item.ram_gb) : '';
        document.getElementById('ram-max').value = checked.has('ram_gb') ? parseNum(item.ram_gb) : '';
        document.getElementById('storage-min').value = checked.has('storage_gb') ? parseNum(item.storage_gb) : '';
        document.getElementById('storage-max').value = checked.has('storage_gb') ? parseNum(item.storage_gb) : '';
        document.getElementById('storage-type').value = checked.has('storage_type') ? (item.storage_type || '') : '';
        document.getElementById('display-size-min').value = checked.has('display_size') ? parseNum(item.display_size) : '';
        document.getElementById('display-size-max').value = checked.has('display_size') ? parseNum(item.display_size) : '';
        document.getElementById('display-size').value = checked.has('display_size') ? parseNum(item.display_size) : '';

        // CPU is multi-select: clear others and set pending for renderCPUOptions if needed
        document.querySelectorAll('#cpu-options input:checked').forEach(cb => cb.checked = false);
        if (checked.has('cpu_raw') && item.cpu_raw) {
            const cpuContainer = document.getElementById('cpu-options');
            const existing = cpuContainer.querySelector(`input[value="${CSS.escape(item.cpu_raw)}"]`);
            if (existing) {
                existing.checked = true;
            } else {
                const pending = cpuContainer.dataset.pending ? JSON.parse(cpuContainer.dataset.pending) : [];
                pending.push(item.cpu_raw);
                cpuContainer.dataset.pending = JSON.stringify(pending);
            }
        }
        renderCPUOptions();

        currentPage = 0;
        closeSimilarModal();
        updateCPUFilterLabel();
        renderActiveFilters();
        saveFilters();
        loadLaptops(0);
    }

    document.getElementById('similar-modal').addEventListener('click', (e) => {
        if (e.target.id === 'similar-modal') closeSimilarModal();
    });
</script>


