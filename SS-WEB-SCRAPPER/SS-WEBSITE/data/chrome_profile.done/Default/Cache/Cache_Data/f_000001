    .laptop-icon-btn .badge-dot {
        position: absolute;
        top: 4px;
        right: 4px;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--primary, #667eea);
        opacity: 0;
        transition: opacity 0.15s;
    }
    .laptop-icon-btn.active {
        background: var(--primary, #667eea);
        border-color: var(--primary, #667eea);
        color: #fff;
        box-shadow: 0 2px 8px rgba(102,126,234,0.35);
    }
    .laptop-icon-btn.active .badge-dot { opacity: 0; }
    .laptop-icon-btn:not(.active) .badge-dot { opacity: 1; }

    /* Per-toggle accent colors when active */
    .laptop-icon-btn.t-macbooks.active  { background: linear-gradient(135deg, #1d1d1f 0%, #3a3a3c 100%); border-color: #1d1d1f; }
    .laptop-icon-btn.t-active.active    { background: linear-gradient(135deg, #16a34a 0%, #0f7a35 100%); border-color: #0f7a35; }
    .laptop-icon-btn.t-flagged.active   { background: linear-gradient(135deg, #dc2626 0%, #9a0006 100%); border-color: #9a0006; }
    .laptop-icon-btn.t-perekups.active  { background: linear-gradient(135deg, #ea580c 0%, #b34000 100%); border-color: #b34000; }
    .laptop-icon-btn.t-lombards.active  { background: linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%); border-color: #7f1d1d; }

    /* Brand "Apple/Asus/..." colored dots inside filter dropdowns */
    .laptop-icon-btn .tooltip {
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        background: var(--card-bg);
        color: var(--text-color);
