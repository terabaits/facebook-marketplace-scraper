    /* ====== Laptop page header: icon-button toggles + stat tiles ====== */
    // Each .laptop-icon-btn[data-target=foo] drives a hidden input #foo with value "true"/"false".
    // The CSS-only `default-on` dot is just a hint when the button is OFF (i.e. the default is off).
    const LAPTOP_TOGGLE_IDS = ['macbook-only', 'active-only', 'exclude-flagged', 'include-perekups', 'include-lombards'];

    function isToggleOn(id) {
        const el = document.getElementById(id);
        if (!el) return false;
        // Hidden inputs use .value; the old checkbox-style fallback covers anything still bound to a checkbox.
        return el.type === 'checkbox' ? !!el.checked : el.value === 'true';
    }

    function setToggle(id, on) {
        const el = document.getElementById(id);
        if (!el) return;
        if (el.type === 'checkbox') el.checked = !!on;
        else el.value = on ? 'true' : 'false';
    }

    function syncToggleButtons() {
        document.querySelectorAll('.laptop-icon-btn[data-target]').forEach(btn => {
            const id = btn.dataset.target;
            const on = isToggleOn(id);
            btn.classList.toggle('active', on);
            btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        });
    }

    function toggleLaptopIcon(btn) {
        const id = btn.dataset.target;
        const next = !isToggleOn(id);
        setToggle(id, next);
        syncToggleButtons();
        loadLaptops();
    }

