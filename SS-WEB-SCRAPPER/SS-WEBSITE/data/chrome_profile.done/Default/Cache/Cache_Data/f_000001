    // Monitor Tier Calculator (client-side version matching Python logic)
    function calculateMonitorTier(size, resolution, refreshRate, panelType) {
        if (!size && !resolution && !refreshRate) {
            return null;
        }
        const sizeNum = parseFloat(size);
        const refreshNum = parseFloat(refreshRate);
        const resLower = (resolution || '').toLowerCase();
        let score = 0;
        if (!isNaN(sizeNum)) {
            if (sizeNum >= 32) score += 3;
            else if (sizeNum >= 27) score += 2;
            else if (sizeNum >= 24) score += 1;
        }
        if (resLower.includes('4k') || resLower.includes('3840') || resLower.includes('2160')) score += 4;
        else if (resLower.includes('1440') || resLower.includes('2560')) score += 2;
        else if (resLower.includes('1080') || resLower.includes('1920')) score += 1;
        if (!isNaN(refreshNum)) {
            if (refreshNum >= 240) score += 4;
            else if (refreshNum >= 144) score += 3;
            else if (refreshNum >= 100) score += 2;
            else if (refreshNum >= 75) score += 1;
        }
        const panelLower = (panelType || '').toLowerCase();
        if (panelLower.includes('oled')) score += 3;
        else if (panelLower.includes('ips') || panelLower.includes('nano')) score += 2;
        else if (panelLower.includes('va')) score += 1;
        if (score >= 10) return 'GOD';
        if (score >= 7) return 'High';
        if (score >= 4) return 'Mid';
        if (score >= 1) return 'Entry';
        return 'Basic';
    }

