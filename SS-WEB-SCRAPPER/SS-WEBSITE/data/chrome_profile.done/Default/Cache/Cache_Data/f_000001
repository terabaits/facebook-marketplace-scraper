    /* ===== Laptop page hero / header ===== */
    .laptop-hero {
        position: relative;
        margin: 0 0 1.25rem;
        padding: 1.25rem 1.5rem 1rem;
        background:
            linear-gradient(135deg, rgba(102,126,234,0.18) 0%, rgba(118,75,162,0.18) 100%),
            var(--card-bg);
        border: 1px solid var(--card-border, rgba(255,255,255,0.06));
